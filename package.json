{
  "name": "pyrite-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/codegen",
    "packages/core",
    "packages/tie",
    "packages/xvt",
    "packages/xwa",
    "packages/xw",
    "packages/components"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint packages --ext .ts",
    "test": "jest --projects packages/*/jest.config.cjs",
    "test:php": "sh -c 'if [ -x vendor/bin/phpunit ]; then exec vendor/bin/phpunit --configuration phpunit.xml \"$@\"; else exec phpunit --configuration phpunit.xml \"$@\"; fi' --",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate": "tsx packages/codegen/src/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
